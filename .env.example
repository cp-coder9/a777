# Configure these values in the hosting environment; never include real secrets in the release artifact.
APP_ENV=production
APP_DEBUG=false
# production hides all demo routes and controls; demo requires a separate MariaDB database.
APP_MODE=production
APP_URL=https://app.example.com
# Generate once with PHP: base64_encode(random_bytes(32)); keep this secret and stable.
APP_KEY=replace-with-a-base64-encoded-32-byte-key

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=architex
DB_USER=architex_app
DB_PASSWORD=replace-with-a-long-random-password

# Leave all SMTP values blank until the provider is available. Registration and password reset fail closed.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Architex

BACKUP_ARCHIVE_PASSWORD=replace-with-a-separate-long-backup-password
FILE_STORAGE_PATH=

# Keep maintenance disabled except during an authenticated preflight/migration window.
MAINTENANCE_ENABLED=0
MAINTENANCE_TOKEN=replace-with-a-long-random-maintenance-token
MAINTENANCE_ALLOW_MIGRATIONS=0
LAST_VERIFIED_BACKUP_ID=
