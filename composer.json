{
  "name": "architex/platform",
  "description": "Architex production platform.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-zip": "*",
    "ext-zlib": "*",
    "setasign/tfpdf": "~1.33.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "Architex\\": "app/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Architex\\Tests\\": "app/tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
